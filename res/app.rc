// Resources for CloudSpotlight.exe. Must compile with both rc.exe (MSVC) and windres (MinGW):
// numeric ids only, ASCII only, no headers beyond <windows.h>.
#include <windows.h>

// IDI_APP = 1: the exe icon (lowest id wins in Explorer) and the tray icon (src/app/Tray.cpp).
1 ICON "app.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24)
1 24 "app.manifest"

// VS_VERSION_INFO (1)
1 VERSIONINFO
FILEVERSION 0, 1, 0, 0
PRODUCTVERSION 0, 1, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Cloud Spotlight"
      VALUE "FileDescription", "Cloud Spotlight"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "CloudSpotlight"
      VALUE "LegalCopyright", "Cloud Spotlight contributors"
      VALUE "OriginalFilename", "CloudSpotlight.exe"
      VALUE "ProductName", "Cloud Spotlight"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
